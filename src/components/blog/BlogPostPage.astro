---
// Blog post template, shared by the FR (/blog/…) and EN (/en/blog/…) routes.
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../ui/Breadcrumbs.astro';
import Callout from '../ui/Callout.astro';
import Tag from '../ui/Tag.astro';
import Portrait from '../ui/Portrait.astro';
import Icon from '../icons/Icon.astro';
import TableOfContents from './TableOfContents.astro';
import AuthorCard from './AuthorCard.astro';
import { AUTHOR, CONTACT, SITE_TITLE } from '../../consts';
import { ROUTES, type Lang } from '../../i18n/ui';
import { useTranslations } from '../../i18n/utils';
import {
  formatDate,
  getPosts,
  getTranslations,
  postLang,
  postUrl,
  readingTime,
  typeset,
  type Post,
} from '../../lib/blog';

interface Props {
  post: Post;
}

const { post } = Astro.props;
const lang = postLang(post);
const t = useTranslations(lang);
const { title, description, pubDate, updatedDate, tags, draft } = post.data;
const { Content, headings } = await render(post);

const minutes = readingTime(post.body);
const translations = await getTranslations(post);
const otherLangs = (Object.keys(translations) as Lang[]).filter((l) => l !== lang);

// Prev/next within the same locale (list is newest first).
const siblings = await getPosts(lang);
const index = siblings.findIndex((p) => p.id === post.id);
const newer = index > 0 ? siblings[index - 1] : undefined;
const older = index >= 0 ? siblings[index + 1] : undefined;

const copy = {
  fr: {
    home: 'Accueil',
    toc: 'Sur cette page',
    copyLink: 'Copier le lien',
    copied: 'Lien copié',
    copyCode: 'Copier',
    codeCopied: 'Copié',
    anchor: 'Lien vers cette section',
    newer: 'Article plus récent',
    older: 'Article précédent',
    draft: 'Brouillon — visible uniquement en développement, jamais publié en production.',
  },
  en: {
    home: 'Home',
    toc: 'On this page',
    copyLink: 'Copy link',
    copied: 'Link copied',
    copyCode: 'Copy',
    codeCopied: 'Copied',
    anchor: 'Link to this section',
    newer: 'Newer post',
    older: 'Older post',
    draft: 'Draft — visible in development only, never published to production.',
  },
}[lang];

const url = new URL(postUrl(post), Astro.site).href;
const blogUrl = new URL(ROUTES.blog[lang], Astro.site).href;

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'BlogPosting',
      headline: title,
      description,
      inLanguage: lang,
      url,
      mainEntityOfPage: url,
      datePublished: pubDate.toISOString(),
      dateModified: (updatedDate ?? pubDate).toISOString(),
      keywords: tags.join(', '),
      wordCount: post.body?.split(/\s+/).filter(Boolean).length,
      image: new URL(AUTHOR.photo, Astro.site).href,
      author: {
        '@type': 'Person',
        name: AUTHOR.name,
        url: Astro.site?.href,
        sameAs: [CONTACT.linkedin, CONTACT.github],
      },
      publisher: { '@type': 'Person', name: AUTHOR.name, url: Astro.site?.href },
      isPartOf: { '@type': 'Blog', name: `${SITE_TITLE} — Blog`, url: blogUrl },
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: copy.home, item: Astro.site?.href },
        { '@type': 'ListItem', position: 2, name: 'Blog', item: blogUrl },
        { '@type': 'ListItem', position: 3, name: title, item: url },
      ],
    },
  ],
};
---

<BaseLayout
  title={`${title} | ${SITE_TITLE}`}
  description={description}
  lang={lang}
  alternates={otherLangs.length ? translations : undefined}
  jsonLd={jsonLd}
  article={{ publishedTime: pubDate, modifiedTime: updatedDate, tags }}
  noindex={draft}
>
  <div
    class="reading-progress pointer-events-none fixed inset-x-0 top-0 z-[60] h-0.5 origin-left scale-x-0 bg-brand"
    aria-hidden="true"
  >
  </div>

  <article>
    <!-- Post header -->
    <header class="relative isolate overflow-hidden border-b border-line">
      <div class="bg-blueprint absolute inset-0 -z-10 opacity-60" aria-hidden="true"></div>
      <div class="bg-glow absolute inset-0 -z-10" aria-hidden="true"></div>

      <div class="container-content pt-10 pb-12 md:pt-14 md:pb-16">
        <Breadcrumbs
          items={[
            { label: copy.home, href: '/' },
            { label: 'Blog', href: ROUTES.blog[lang] },
            { label: title },
          ]}
        />

        <div class="mt-10 max-w-3xl animate-fade-up md:mt-14">
          {
            draft && (
              <p class="mb-6 inline-flex items-center gap-2 rounded-md border border-warning/35 bg-warning-soft px-3 py-1.5 text-sm text-warning">
                <Icon name="alert-triangle" size={15} />
                {copy.draft}
              </p>
            )
          }
          <div class="flex flex-wrap gap-1.5">
            {tags.map((tag) => <Tag variant="accent">#{tag}</Tag>)}
          </div>
          <h1 class="mt-5 text-h1">{typeset(title, lang)}</h1>
          <p class="mt-6 text-lead text-fg-muted">{typeset(description, lang)}</p>

          <div class="mt-9 flex flex-wrap items-center gap-x-5 gap-y-3 border-t border-line pt-6">
            <div class="flex items-center gap-3">
              <Portrait size={36} alt="" />
              <span class="text-sm font-bold text-fg">{AUTHOR.name}</span>
            </div>
            <span class="text-label flex flex-wrap items-center gap-x-2 text-fg-subtle">
              <time datetime={pubDate.toISOString()}>{formatDate(pubDate, lang)}</time>
              <span aria-hidden="true">·</span>
              <span>{`${minutes} ${t('blog.readingTime')}`}</span>
              {
                updatedDate && (
                  <>
                    <span aria-hidden="true">·</span>
                    <span>
                      {t('blog.updatedOn')}{' '}
                      <time datetime={updatedDate.toISOString()}>
                        {formatDate(updatedDate, lang)}
                      </time>
                    </span>
                  </>
                )
              }
            </span>
            {
              otherLangs.map((l) => (
                <a
                  href={translations[l]}
                  hreflang={l}
                  lang={l}
                  class="text-label inline-flex items-center gap-1.5 text-accent hover:underline"
                >
                  <Icon name="globe" size={14} />
                  {l === 'en' ? 'Read in English' : 'Lire en français'}
                </a>
              ))
            }
          </div>
        </div>
      </div>
    </header>

    <!-- Body + aside -->
    <div
      class="container-content grid gap-12 py-14 md:py-20 lg:grid-cols-[minmax(0,1fr)_15rem] lg:gap-16 xl:grid-cols-[minmax(0,1fr)_17rem]"
    >
      <div class="min-w-0">
        <details class="mb-10 rounded-lg border border-line bg-subtle lg:hidden">
          <summary
            class="text-label flex cursor-pointer list-none items-center justify-between px-4 py-3 text-fg-muted"
          >
            <span><span class="text-accent">{'// '}</span>{copy.toc}</span>
            <Icon name="arrow-right" size={14} class="rotate-90" />
          </summary>
          <TableOfContents headings={headings} title={copy.toc} class="px-4 pb-4 [&>p]:hidden" />
        </details>

        <div
          class="prose-article max-w-reading"
          data-article-body
          data-copy-label={copy.copyCode}
          data-copied-label={copy.codeCopied}
          data-anchor-label={copy.anchor}
        >
          <Content components={{ Callout }} />
        </div>

        <!-- Post footer -->
        <footer class="mt-16 max-w-reading space-y-10 border-t border-line pt-10">
          <div class="flex flex-wrap items-center justify-between gap-4">
            <div class="flex flex-wrap gap-1.5">
              {tags.map((tag) => <Tag variant="accent">#{tag}</Tag>)}
            </div>
            <button
              type="button"
              class="copy-link text-label inline-flex items-center gap-2 rounded-md border border-line-strong px-3 py-1.5 text-fg-muted transition-colors hover:border-accent hover:text-accent"
              data-label={copy.copyLink}
              data-done={copy.copied}
            >
              <Icon name="link" size={14} />
              <span>{copy.copyLink}</span>
            </button>
          </div>

          <AuthorCard lang={lang} />

          {
            (newer || older) && (
              <nav class="grid gap-4 sm:grid-cols-2" aria-label="Articles">
                {older ? (
                  <a
                    href={postUrl(older)}
                    class="group rounded-xl border border-line p-5 transition-colors hover:border-accent-line"
                  >
                    <span class="text-label inline-flex items-center gap-1.5 text-fg-subtle">
                      <Icon name="arrow-left" size={14} />
                      {copy.older}
                    </span>
                    <span class="mt-2 block font-bold text-fg group-hover:text-accent">
                      {older.data.title}
                    </span>
                  </a>
                ) : (
                  <span />
                )}
                {newer && (
                  <a
                    href={postUrl(newer)}
                    class="group rounded-xl border border-line p-5 text-right transition-colors hover:border-accent-line"
                  >
                    <span class="text-label inline-flex items-center gap-1.5 text-fg-subtle">
                      {copy.newer}
                      <Icon name="arrow-right" size={14} />
                    </span>
                    <span class="mt-2 block font-bold text-fg group-hover:text-accent">
                      {newer.data.title}
                    </span>
                  </a>
                )}
              </nav>
            )
          }

          <a
            href={ROUTES.blog[lang]}
            class="text-label inline-flex items-center gap-2 text-fg-muted hover:text-accent"
          >
            <Icon name="arrow-left" size={14} />
            {t('blog.allPosts')}
          </a>
        </footer>
      </div>

      <aside class="hidden lg:block">
        <div class="sticky top-[calc(var(--header-height)+2.5rem)] space-y-8">
          <TableOfContents headings={headings} title={copy.toc} />
          <a
            href="#top"
            class="text-label inline-flex items-center gap-1.5 text-fg-subtle hover:text-accent"
          >
            <Icon name="arrow-up" size={14} />
            {t('footer.backToTop')}
          </a>
        </div>
      </aside>
    </div>
  </article>
</BaseLayout>

<script>
  const body = document.querySelector<HTMLElement>('[data-article-body]');

  if (body) {
    // Reading progress bar.
    const bar = document.querySelector<HTMLElement>('.reading-progress');
    if (bar) {
      const update = () => {
        const rect = body.getBoundingClientRect();
        const total = rect.height - innerHeight * 0.6;
        const progress = Math.min(1, Math.max(0, -rect.top / Math.max(total, 1)));
        bar.style.transform = `scaleX(${progress})`;
      };
      update();
      addEventListener('scroll', update, { passive: true });
      addEventListener('resize', update);
    }

    // "#" anchors on headings.
    const anchorLabel = body.dataset.anchorLabel ?? 'Link to this section';
    const headings = body.querySelectorAll<HTMLHeadingElement>('h2[id], h3[id], h4[id]');
    for (const heading of headings) {
      const a = document.createElement('a');
      a.href = `#${heading.id}`;
      a.className = 'heading-anchor';
      a.textContent = '#';
      a.setAttribute('aria-label', anchorLabel);
      heading.append(a);
    }

    // Copy buttons on code blocks.
    const copyLabel = body.dataset.copyLabel ?? 'Copy';
    const copiedLabel = body.dataset.copiedLabel ?? 'Copied';
    for (const pre of body.querySelectorAll('pre')) {
      const button = document.createElement('button');
      button.type = 'button';
      button.className = 'code-copy';
      button.textContent = copyLabel;
      button.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText(pre.querySelector('code')?.innerText ?? '');
          button.textContent = copiedLabel;
          setTimeout(() => (button.textContent = copyLabel), 1600);
        } catch {
          /* clipboard unavailable */
        }
      });
      pre.append(button);
    }

    // Active entry in the table of contents.
    const links = new Map<string, HTMLAnchorElement[]>();
    for (const link of document.querySelectorAll<HTMLAnchorElement>('.toc a[href^="#"]')) {
      const id = decodeURIComponent(link.hash.slice(1));
      links.set(id, [...(links.get(id) ?? []), link]);
    }
    const tracked = [...body.querySelectorAll<HTMLElement>('h2[id], h3[id]')].filter((h) =>
      links.has(h.id)
    );
    if (tracked.length) {
      const setActive = (id: string) => {
        for (const [key, anchors] of links) {
          for (const a of anchors) {
            if (key === id) a.setAttribute('aria-current', 'location');
            else a.removeAttribute('aria-current');
          }
        }
      };
      const onScroll = () => {
        const offset = innerHeight * 0.25;
        let current = tracked[0].id;
        for (const h of tracked) if (h.getBoundingClientRect().top - offset < 0) current = h.id;
        setActive(current);
      };
      onScroll();
      addEventListener('scroll', onScroll, { passive: true });
    }
  }

  // Copy-link button.
  for (const button of document.querySelectorAll<HTMLButtonElement>('.copy-link')) {
    button.addEventListener('click', async () => {
      const label = button.querySelector('span');
      try {
        await navigator.clipboard.writeText(location.href.split('#')[0]);
        if (label) label.textContent = button.dataset.done ?? 'Copied';
        setTimeout(() => label && (label.textContent = button.dataset.label ?? 'Copy link'), 1800);
      } catch {
        /* clipboard unavailable */
      }
    });
  }
</script>
