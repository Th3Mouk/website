---
// Theme toggle: flips light <-> dark and remembers the choice. The initial
// theme is set pre-paint by the inline script in BaseHead (localStorage,
// else prefers-color-scheme), so this component only handles clicks.
import IconButton from './ui/IconButton.astro';
import Icon from './icons/Icon.astro';

interface Props {
  label: string;
}

const { label } = Astro.props;
---

<IconButton label={label} class="theme-toggle">
  <!-- Sun: shown in dark mode (click → light). Moon: shown in light mode. -->
  <Icon name="sun" size={18} class="hidden dark:block" />
  <Icon name="moon" size={18} class="dark:hidden" />
</IconButton>

<script>
  for (const button of document.querySelectorAll<HTMLButtonElement>('.theme-toggle')) {
    button.addEventListener('click', () => {
      const html = document.documentElement;
      const next = html.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
      html.setAttribute('data-theme', next);
      try {
        localStorage.setItem('theme', next);
      } catch {
        // Private mode / blocked storage: the toggle still works for this page.
      }
    });
  }
</script>
