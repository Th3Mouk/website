---
// BulletList — list with the accent `›` marker.
//   mono   compact mono items (feature bullets at the foot of a card)
//   body   sans body text (objectives, longer items)
interface Props {
  items: readonly string[];
  variant?: 'mono' | 'body';
  class?: string;
}

const { items, variant = 'body', class: className } = Astro.props;
---

<ul
  class:list={[
    variant === 'mono' ? 'space-y-2 font-mono text-mono-sm' : 'space-y-2.5 text-body',
    'text-fg-muted',
    className,
  ]}
>
  {
    items.map((item) => (
      <li class="flex items-start gap-2.5">
        <span
          class:list={[
            'font-mono font-bold text-accent',
            variant === 'body' ? 'leading-[1.7]' : '',
          ]}
          aria-hidden="true"
        >
          ›
        </span>
        <span>{item}</span>
      </li>
    ))
  }
</ul>
