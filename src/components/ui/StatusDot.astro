---
// StatusDot — live-state indicator (availability, project status).
// The halo pulses only for `available`, so "something is alive" stays the
// one animated signal on a page.
interface Props {
  status?: 'available' | 'busy' | 'unavailable';
  label?: string;
  class?: string;
}

const { status = 'available', label, class: className } = Astro.props;

const colors = {
  available: 'bg-success',
  busy: 'bg-warning',
  unavailable: 'bg-danger',
};

const labels = {
  available: 'Disponible',
  busy: 'Occupé',
  unavailable: 'Indisponible',
};
---

<span
  class:list={['inline-flex items-center gap-2 font-mono text-mono-sm text-fg-muted', className]}
>
  <span class="relative flex size-2" aria-hidden="true">
    {
      status === 'available' && (
        <span class:list={['absolute inset-0 animate-pulse-soft rounded-full', colors[status]]} />
      )
    }
    <span class:list={['relative inline-flex size-2 rounded-full', colors[status]]}></span>
  </span>
  {label ?? labels[status]}
</span>
