---
// Kicker — mono label above a headline, written as a code comment
// ("// section-name"): the signature of the site's technical voice.
// Optional `index` prefixes a step number ("// 01 · services").
type KickerTag = 'p' | 'span' | 'div';

interface Props {
  index?: string | number;
  tag?: KickerTag;
  class?: string;
}

const { index, tag: Tag = 'p', class: className } = Astro.props;
const idx = index === undefined ? undefined : String(index).padStart(2, '0');
---

<Tag class:list={['text-label flex items-center gap-2 text-fg-subtle', className]}>
  <span class="text-accent" aria-hidden="true">{'//'}</span>
  {
    idx && (
      <>
        <span class="text-fg-muted">{idx}</span>
        <span aria-hidden="true">·</span>
      </>
    )
  }
  <span><slot /></span>
</Tag>
