---
// SectionHeader — kicker + title + lead, the opening of every section.
// The `actions` slot sits on the right on desktop (e.g. "See all →").
import SectionKicker from './SectionKicker.astro';

type HeadingTag = 'h1' | 'h2' | 'h3';

interface Props {
  kicker?: string;
  index?: string | number;
  title: string;
  lead?: string;
  /** Heading level. Sections use h2; a page hero passes h1. */
  tag?: HeadingTag;
  /** Title size token. Defaults to the heading level's size. */
  size?: 'display' | 'h1' | 'h2' | 'h3';
  id?: string;
  class?: string;
}

const { kicker, index, title, lead, tag: Heading = 'h2', size, id, class: className } = Astro.props;

const sizeClass = {
  display: 'text-display',
  h1: 'text-h1',
  h2: 'text-h2',
  h3: 'text-h3',
}[size ?? (Heading === 'h1' ? 'h1' : Heading === 'h3' ? 'h3' : 'h2')];

const hasActions = Astro.slots.has('actions');
---

<header
  class:list={[
    'flex flex-col gap-6',
    hasActions && 'md:flex-row md:items-end md:justify-between',
    className,
  ]}
>
  <div class="max-w-3xl">
    {
      kicker && (
        <SectionKicker index={index} class="mb-4">
          {kicker}
        </SectionKicker>
      )
    }
    <Heading id={id} class={sizeClass}>{title}</Heading>
    {lead && <p class="mt-5 max-w-2xl text-lead text-fg-muted">{lead}</p>}
  </div>
  {
    hasActions && (
      <div class="flex shrink-0 flex-wrap items-center gap-3">
        <slot name="actions" />
      </div>
    )
  }
</header>
