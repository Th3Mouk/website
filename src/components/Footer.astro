---
import LinkedIn from './icons/LinkedIn.astro';
import Github from './icons/Github.astro';
import Icon from './icons/Icon.astro';
import StatusDot from './ui/StatusDot.astro';
import { SITE_TITLE, CONTACT, mailLink } from '../consts';
import { ROUTES, defaultLang, type Lang } from '../i18n/ui';
import { useTranslations } from '../i18n/utils';
import { getPosts } from '../lib/blog';

interface Props {
  lang?: Lang;
}

const { lang = defaultLang } = Astro.props;
const t = useTranslations(lang);
const year = new Date().getFullYear();
const hasPosts = (await getPosts(lang)).length > 0;

const pages = [
  { href: ROUTES.home[lang], label: t('nav.home') },
  { href: ROUTES.training[lang], label: t('nav.training') },
  { href: ROUTES.projects[lang], label: t('nav.projects') },
  { href: ROUTES.about[lang], label: t('nav.about') },
];

const resources = [
  ...(hasPosts
    ? [
        { href: ROUTES.blog[lang], label: t('nav.blog') },
        { href: `${ROUTES.blog[lang]}rss.xml`, label: t('footer.rss') },
      ]
    : []),
];

const linkClass = 'text-fg-muted transition-colors duration-200 hover:text-accent';
---

<footer class="border-t border-line bg-subtle">
  <div class="container-content py-14 md:py-16">
    <div class="grid gap-12 md:grid-cols-[minmax(0,2fr)_repeat(3,minmax(0,1fr))] md:gap-8">
      <!-- Brand -->
      <div class="max-w-sm">
        <p class="flex items-center gap-2.5 font-bold text-fg">
          <span
            class="grid size-8 place-items-center rounded-md bg-fg font-mono text-mono-sm text-canvas"
            aria-hidden="true">jm</span
          >
          <span>
            {SITE_TITLE}<span class="font-mono font-normal text-accent" aria-hidden="true">/</span>
          </span>
        </p>
        <p class="mt-4 text-sm text-fg-muted">{t('footer.tagline')}</p>
        <StatusDot status="available" label={t('status.available')} class="mt-6" />
      </div>

      <!-- Pages -->
      <nav aria-labelledby="footer-pages">
        <p id="footer-pages" class="text-label text-fg-subtle">
          <span class="text-accent" aria-hidden="true">{'// '}</span>{t('footer.pages')}
        </p>
        <ul class="mt-4 space-y-2.5 text-sm">
          {
            pages.map((page) => (
              <li>
                <a href={page.href} class={linkClass}>
                  {page.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <!-- Resources (blog + feed): only once there is something to read -->
      {
        resources.length > 0 ? (
          <nav aria-labelledby="footer-resources">
            <p id="footer-resources" class="text-label text-fg-subtle">
              <span class="text-accent" aria-hidden="true">
                {'// '}
              </span>
              {t('footer.resources')}
            </p>
            <ul class="mt-4 space-y-2.5 text-sm">
              {resources.map((item) => (
                <li>
                  <a href={item.href} class={linkClass}>
                    {item.label}
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        ) : (
          <div class="max-md:hidden" aria-hidden="true" />
        )
      }

      <!-- Contact -->
      <div>
        <p class="text-label text-fg-subtle">
          <span class="text-accent" aria-hidden="true">{'// '}</span>{t('footer.connect')}
        </p>
        <ul class="mt-4 space-y-2.5 text-sm">
          <li>
            <a {...mailLink()} class:list={[linkClass, 'inline-flex items-center gap-2']}>
              <Icon name="mail" size={15} />
              Email
            </a>
          </li>
          <li>
            <a
              href={CONTACT.linkedin}
              target="_blank"
              rel="noopener noreferrer"
              class:list={[linkClass, 'inline-flex items-center gap-2']}
            >
              <LinkedIn size={15} />
              LinkedIn
            </a>
          </li>
          <li>
            <a
              href={CONTACT.github}
              target="_blank"
              rel="noopener noreferrer"
              class:list={[linkClass, 'inline-flex items-center gap-2']}
            >
              <Github size={15} />
              GitHub
            </a>
          </li>
        </ul>
      </div>
    </div>

    <div
      class="mt-14 flex flex-col gap-4 border-t border-line pt-6 font-mono text-mono-sm text-fg-subtle sm:flex-row sm:items-center sm:justify-between"
    >
      <p>&copy; {year} {SITE_TITLE}. {t('footer.rights')}</p>
      <div class="flex items-center gap-5">
        <p>
          {t('footer.builtWith')}
          <a href="https://astro.build" target="_blank" rel="noopener noreferrer" class={linkClass}
            >Astro</a
          >
        </p>
        <a href="#top" class:list={[linkClass, 'inline-flex items-center gap-1.5']}>
          {t('footer.backToTop')}
          <Icon name="arrow-up" size={14} />
        </a>
      </div>
    </div>
  </div>
</footer>
