---
import LinkedIn from './icons/LinkedIn.astro';
import Github from './icons/Github.astro';

const today = new Date();
---

<footer class="bg-base-200 text-base-content/60 py-8">
  <div class="container mx-auto px-4 flex flex-col items-center gap-4 text-center">
    <p>&copy; {today.getFullYear()} Jérémy Marodon. All rights reserved.</p>
    <div class="flex justify-center gap-4">
      <a
        href="https://www.linkedin.com/in/jeremymarodon/"
        target="_blank"
        class="hover:text-primary transition-colors"
      >
        <span class="sr-only">Contact me on LinkedIn</span>
        <LinkedIn size={32} />
      </a>
      <a
        href="https://github.com/Th3Mouk"
        target="_blank"
        class="hover:text-primary transition-colors"
      >
        <span class="sr-only">Go to my GitHub repo</span>
        <Github size={32} />
      </a>
    </div>
  </div>
</footer>
