---
import HeaderLink from './HeaderLink.astro';
import { SITE_TITLE } from '../consts';
import ThemeToggle from './ThemeToggle.astro';
import LinkedIn from './icons/LinkedIn.astro';
import Github from './icons/Github.astro';
---

<header class="bg-base-200 shadow-lg">
  <nav class="container mx-auto px-4 py-4">
    <div class="flex items-center justify-between">
      <h2 class="text-2xl font-bold">
        <a href="/" class="text-primary hover:text-primary-focus">{SITE_TITLE}</a>
      </h2>

      <div class="flex items-center space-x-8">
        <div class="hidden md:flex space-x-6">
          <HeaderLink href="/" class="text-base-content hover:text-primary">Home</HeaderLink>
          <HeaderLink href="/formation" class="text-base-content hover:text-primary">Formations</HeaderLink>
          <!-- <HeaderLink href="/blog" class="text-base-content hover:text-primary">Blog</HeaderLink> -->
          <!-- <HeaderLink href="/about" class="text-base-content hover:text-primary">About</HeaderLink> -->
        </div>

        <div class="flex items-center space-x-4">
          <ThemeToggle />
          <div class="social-links flex space-x-4">
            <a
              href="https://www.linkedin.com/in/jeremymarodon/"
              target="_blank"
              class="text-base-content hover:text-primary"
            >
              <span class="sr-only">Contact me on LinkedIn</span>
              <LinkedIn size={32} class="fill-current" />
            </a>
            <a
              href="https://github.com/Th3Mouk"
              target="_blank"
              class="text-base-content hover:text-primary"
            >
              <span class="sr-only">Go to my GitHub repo</span>
              <Github size={32} class="fill-current" />
            </a>
          </div>
        </div>
      </div>
    </div>
  </nav>
</header>
