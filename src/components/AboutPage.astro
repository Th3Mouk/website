---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from './ui/Button.astro';
import Card from './ui/Card.astro';
import Section from './ui/Section.astro';
import SectionHeader from './ui/SectionHeader.astro';
import SectionKicker from './ui/SectionKicker.astro';
import StatusDot from './ui/StatusDot.astro';
import Tag from './ui/Tag.astro';
import Portrait from './ui/Portrait.astro';
import Timeline from './ui/Timeline.astro';
import Testimonial from './ui/Testimonial.astro';
import ContactCta from './ui/ContactCta.astro';
import Icon from './icons/Icon.astro';
import { testimonials } from '../data/testimonials';
import { ROUTES, localePaths, type Lang } from '../i18n/ui';
import { AUTHOR, CONTACT } from '../consts';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;

interface SkillGroup {
  category: string;
  items: readonly string[];
}

interface SoftSkill {
  title: string;
  description: string;
  /** Verbatim French LinkedIn quote — never translated. */
  proofQuote: string;
  proofAuthor: string;
}

interface TimelineEntry {
  period: string;
  title: string;
  context?: string;
  note?: string;
}

// Soft-skill proofs are verbatim quotes from the LinkedIn recommendations in
// src/data/testimonials.ts — no claim without proof. They stay in French on
// both locales (rendered with lang="fr").
const proofs = {
  pedagogy: {
    proofQuote:
      "Une personne qui n'hésite pas à partager ce qui se fait de meilleur en termes de process tech, d'expériences et de capacités à proposer des solutions réalistes face à des problèmes complexes — le tout avec un esprit pédagogique hors normes.",
    proofAuthor: 'Ilyes Abd-Lillah, Lead Front-end',
  },
  leadership: {
    proofQuote:
      'Si vous recherchez un leader technique capable de mettre les mains dans le cambouis pour montrer la bonne direction, alors Jérémy est le candidat idéal.',
    proofAuthor: 'Kévin Bargoin, Expert Kubernetes',
  },
  rigour: {
    proofQuote:
      "Côté technique, Jérémy fait preuve d'excellence. Il sait prendre les bonnes décisions. Il est sensible à la qualité ce qui est aussi un point important dans une équipe.",
    proofAuthor: 'Mehdi Tassi, Manager QA/QE',
  },
  communication: {
    proofQuote:
      "C'est un excellent développeur, un très bon communicateur mais aussi un collaborateur très apprécié. Il est capable d'inspirer son équipe et il a une vision claire de ce qu'il veut accomplir.",
    proofAuthor: 'Kévin Bargoin, Expert Kubernetes',
  },
};

// Page-specific copy lives next to the page (one file to edit). Shared
// chrome strings (nav, footer) live in src/i18n/ui.ts.
// TODO(content): la bio longue est un draft basé sur les recos LinkedIn et
// les stats du site. À relire et personnaliser par Jérémy.
// TODO(content): périodes de la chronologie approximatives — reconstruites
// depuis les recos LinkedIn (Kévin Bargoin : 4+ ans chez Domraider ; Mehdi
// Tassi : 2 ans chez Skilleos ; Anthony Thomas : 3 structures). À valider
// avec le CV.
const copy = {
  fr: {
    seoTitle: 'À propos | Jérémy Marodon',
    seoDescription:
      'Parcours, expertise technique (PHP, Symfony, AWS, IaC, conformité ISO 27001 / SOC 2 / RGPD), soft skills et recommandations de Jérémy Marodon — formateur et consultant tech.',
    portraitAlt: `Portrait de ${AUTHOR.name}`,
    figCaption: 'fig.02 — à propos',
    kicker: 'à propos',
    h1Before: 'Bonjour, je suis ',
    h1After: '.',
    bio: [
      "Je suis développeur depuis 2013 et formateur depuis presque aussi longtemps. J'aide les entreprises et les développeurs à livrer du logiciel solide, et à faire monter en compétences les équipes qui le construisent.",
      "J'ai grandi techniquement sur PHP/Symfony (depuis Symfony 1.4), puis JavaScript et l'écosystème front moderne, avant d'attraper le DevOps et l'infrastructure par nécessité — quand un produit prod tombe à 3h du matin, on apprend vite. Depuis deux ans, je suis responsable d'une infrastructure complète sur AWS, en Infrastructure-as-Code, avec les contraintes de conformité qui vont avec (ISO 27001, SOC 2, RGPD). Aujourd'hui je passe autant de temps à transmettre qu'à coder, et j'aime beaucoup ça.",
    ],
    credo:
      "Mon credo : la qualité technique se construit par petites décisions cohérentes, pas par grands plans. Et la meilleure façon de faire monter une équipe, c'est de coder avec elle.",
    available: 'Disponible',
    remote: 'À distance & sur site',
    contact: 'Me contacter',
    hardSkills: [
      { category: 'Langages', items: ['PHP 8+', 'JavaScript', 'TypeScript'] },
      { category: 'Backend', items: ['Symfony', 'Doctrine ORM', 'Node.js', 'API REST'] },
      { category: 'Frontend', items: ['React', 'Vue.js', 'Astro', 'Tailwind'] },
      { category: 'Data', items: ['PostgreSQL', 'MySQL', 'MongoDB', 'Redis'] },
      { category: 'Cloud & infra', items: ['AWS', 'Docker', 'Kubernetes'] },
      {
        category: 'IaC & CI/CD',
        items: ['Terraform', 'Pulumi', 'Ansible', 'GitHub Actions', 'GitLab CI'],
      },
      { category: 'Observabilité', items: ['Prometheus', 'Grafana', 'Sentry'] },
      { category: 'Conformité & sécurité', items: ['ISO 27001', 'SOC 2', 'SOC 3', 'RGPD'] },
      { category: 'Qualité', items: ['Tests unitaires & E2E', 'CI/CD', 'Code review'] },
      { category: 'IA', items: ['OpenAI GPT', 'Anthropic Claude', 'Intégration LLM'] },
      { category: 'Méthodes', items: ['Agile', 'Scrum', 'Kanban', 'Git', 'TDD'] },
    ],
    skillsKicker: 'stack & outils',
    skillsTitle: 'Compétences techniques',
    skillsLead: "Ce avec quoi je travaille au quotidien. Le reste s'apprend.",
    skillsFiller: "le reste s'apprend",
    softSkills: [
      {
        title: 'Pédagogie',
        description:
          'Transmettre clairement, du junior au senior. Capable de vulgariser sans simplifier à outrance, et de faire monter une équipe en compétences sur le temps long.',
        ...proofs.pedagogy,
      },
      {
        title: 'Leadership technique',
        description:
          "Donner le cap, embarquer l'équipe, mettre les mains dans le code quand il faut. Pas de leader en tour d'ivoire : la décision technique se justifie en lisant le code.",
        ...proofs.leadership,
      },
      {
        title: 'Excellence & rigueur',
        description:
          "Sensible à la qualité du code, à la stabilité en prod, aux choix d'architecture qui tiennent dans le temps. Préfère un build vert à un feature push.",
        ...proofs.rigour,
      },
      {
        title: 'Communication',
        description:
          "Explique le 'pourquoi' avant le 'comment'. Sait parler aux devs, aux PM, aux parties prenantes — et faire converger les conversations vers des décisions partagées.",
        ...proofs.communication,
      },
    ],
    methodKicker: 'méthode',
    methodTitle: 'Soft skills, version preuves',
    methodLead:
      "Pas de buzzwords sans preuve. Chaque qualité est appuyée par une recommandation LinkedIn d'un ancien collègue ou manager.",
    timeline: [
      {
        period: "2024 — aujourd'hui",
        title: 'Formateur, Consultant & Responsable Infrastructure',
        note: "Formation, audit technique, missions de dev — et responsable d'une infrastructure cloud (AWS, IaC) avec contraintes de conformité (ISO 27001, SOC 2, RGPD).",
      },
      {
        period: '2022 — 2024',
        title: 'Lead Tech',
        context: 'Skilleos',
        note: 'Mise en place des tests perf/API/E2E en CI/CD, qualité produit.',
      },
      {
        period: '2018 — 2022',
        title: 'Lead Developer',
        context: 'Domraider',
        note: 'Front (React) + back (Symfony), leadership tech, partage de connaissance.',
      },
      {
        period: '2013 — 2018',
        title: 'Développeur',
        context: 'Plusieurs structures',
        note: 'Démarrage carrière — backend PHP / Symfony 1.4 → 4.x.',
      },
    ],
    timelineKicker: 'chronologie',
    timelineTitle: 'Parcours',
    recoId: 'recommandations',
    recoKicker: 'recommandations',
    recoTitle: "Ce qu'ils disent — version intégrale",
    recoLead: 'Recommandations LinkedIn complètes. Les originaux sont sur mon profil.',
    linkedinProfile: 'Profil LinkedIn',
    ctaTitle: 'Discutons de votre projet',
    ctaText:
      'Formation, accompagnement, audit, mission de dev — décrivez-moi le contexte, je reviens vers vous rapidement.',
  },
  en: {
    seoTitle: 'About | Jérémy Marodon',
    seoDescription:
      'Background, technical expertise (PHP, Symfony, AWS, IaC, ISO 27001 / SOC 2 / GDPR compliance), soft skills and recommendations of Jérémy Marodon — tech trainer and consultant.',
    portraitAlt: `Portrait of ${AUTHOR.name}`,
    figCaption: 'fig.02 — about',
    kicker: 'about',
    h1Before: "Hi, I'm ",
    h1After: '.',
    bio: [
      'I have been a developer since 2013 and a trainer for almost as long. I help companies and developers ship solid software, and upskill the teams who build it.',
      'I grew up technically on PHP/Symfony (since Symfony 1.4), then JavaScript and the modern front-end ecosystem, before picking up DevOps and infrastructure out of necessity — when a production system goes down at 3 a.m., you learn fast. For the past two years I have been responsible for a complete AWS infrastructure, managed as Infrastructure-as-Code, with the compliance constraints that come with it (ISO 27001, SOC 2, GDPR). Today I spend as much time teaching as I do coding, and I enjoy it a lot.',
    ],
    credo:
      'My credo: technical quality is built through small, consistent decisions, not grand plans. And the best way to grow a team is to write code with it.',
    available: 'Available',
    remote: 'Remote & on-site',
    contact: 'Get in touch',
    hardSkills: [
      { category: 'Languages', items: ['PHP 8+', 'JavaScript', 'TypeScript'] },
      { category: 'Backend', items: ['Symfony', 'Doctrine ORM', 'Node.js', 'REST APIs'] },
      { category: 'Frontend', items: ['React', 'Vue.js', 'Astro', 'Tailwind'] },
      { category: 'Data', items: ['PostgreSQL', 'MySQL', 'MongoDB', 'Redis'] },
      { category: 'Cloud & infra', items: ['AWS', 'Docker', 'Kubernetes'] },
      {
        category: 'IaC & CI/CD',
        items: ['Terraform', 'Pulumi', 'Ansible', 'GitHub Actions', 'GitLab CI'],
      },
      { category: 'Observability', items: ['Prometheus', 'Grafana', 'Sentry'] },
      { category: 'Compliance & security', items: ['ISO 27001', 'SOC 2', 'SOC 3', 'GDPR'] },
      { category: 'Quality', items: ['Unit & E2E tests', 'CI/CD', 'Code review'] },
      { category: 'AI', items: ['OpenAI GPT', 'Anthropic Claude', 'LLM integration'] },
      { category: 'Methods', items: ['Agile', 'Scrum', 'Kanban', 'Git', 'TDD'] },
    ],
    skillsKicker: 'stack & tools',
    skillsTitle: 'Technical skills',
    skillsLead: 'What I work with every day. The rest can be learned.',
    skillsFiller: 'the rest can be learned',
    softSkills: [
      {
        title: 'Teaching',
        description:
          'Explaining clearly, from junior to senior. Able to make things accessible without oversimplifying, and to grow a team’s skills over the long run.',
        ...proofs.pedagogy,
      },
      {
        title: 'Technical leadership',
        description:
          'Setting the direction, bringing the team along, getting hands-on in the code when needed. No ivory-tower leadership: a technical decision is justified by reading the code.',
        ...proofs.leadership,
      },
      {
        title: 'Excellence & rigour',
        description:
          'Attentive to code quality, production stability and architecture choices that hold up over time. Prefers a green build to a pushed feature.',
        ...proofs.rigour,
      },
      {
        title: 'Communication',
        description:
          'Explains the “why” before the “how”. Can talk to developers, PMs and stakeholders — and steer conversations towards shared decisions.',
        ...proofs.communication,
      },
    ],
    methodKicker: 'method',
    methodTitle: 'Soft skills, with proof',
    methodLead:
      'No buzzwords without proof. Each quality is backed by a LinkedIn recommendation from a former colleague or manager, quoted in its original French.',
    timeline: [
      {
        period: '2024 — present',
        title: 'Trainer, Consultant & Head of Infrastructure',
        note: 'Training, technical audits, development engagements — and responsible for a cloud infrastructure (AWS, IaC) under compliance constraints (ISO 27001, SOC 2, GDPR).',
      },
      {
        period: '2022 — 2024',
        title: 'Tech Lead',
        context: 'Skilleos',
        note: 'Set up performance/API/E2E tests in CI/CD, product quality.',
      },
      {
        period: '2018 — 2022',
        title: 'Lead Developer',
        context: 'Domraider',
        note: 'Front end (React) + back end (Symfony), technical leadership, knowledge sharing.',
      },
      {
        period: '2013 — 2018',
        title: 'Developer',
        context: 'Several companies',
        note: 'Early career — PHP back end / Symfony 1.4 → 4.x.',
      },
    ],
    timelineKicker: 'timeline',
    timelineTitle: 'Career',
    recoId: 'recommendations',
    recoKicker: 'recommendations',
    recoTitle: 'What they say — in full',
    recoLead:
      'Complete LinkedIn recommendations, in their original French. The originals are on my profile.',
    linkedinProfile: 'LinkedIn profile',
    ctaTitle: "Let's talk about your project",
    ctaText:
      'Training, advisory, audit, a development engagement — tell me about the context and I will get back to you quickly.',
  },
} as const;

const c = copy[lang];
const alternates = localePaths('about');
const hardSkills: readonly SkillGroup[] = c.hardSkills;
const softSkills: readonly SoftSkill[] = c.softSkills;
const timeline: TimelineEntry[] = [...c.timeline];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ProfilePage',
  name: c.seoTitle,
  description: c.seoDescription,
  inLanguage: lang,
  url: new URL(ROUTES.about[lang], Astro.site).href,
  mainEntity: {
    '@type': 'Person',
    '@id': `${Astro.site}#person`,
    name: AUTHOR.name,
    image: new URL(AUTHOR.photo, Astro.site).href,
    sameAs: [CONTACT.linkedin, CONTACT.github],
    knowsAbout: hardSkills.flatMap((group) => group.items),
  },
};
---

<BaseLayout
  title={c.seoTitle}
  description={c.seoDescription}
  lang={lang}
  alternates={alternates}
  jsonLd={jsonLd}
>
  <!-- Hero -->
  <section class="relative isolate overflow-hidden border-b border-line">
    <div class="bg-blueprint absolute inset-0 -z-10 opacity-70" aria-hidden="true"></div>
    <div class="bg-glow absolute inset-0 -z-10" aria-hidden="true"></div>

    <div
      class="container-content grid gap-12 pt-14 pb-16 md:grid-cols-[17rem_minmax(0,1fr)] md:gap-14 md:pt-24 md:pb-20 lg:grid-cols-[20rem_minmax(0,1fr)] lg:gap-20"
    >
      <div class="animate-fade-up max-md:hidden">
        <Portrait variant="framed" size={320} eager alt={c.portraitAlt} caption="fig.02">
          <Fragment slot="caption">
            <span>{c.figCaption}</span>
            <span>2013 → 2026</span>
          </Fragment>
        </Portrait>
      </div>

      <div class="animate-fade-up [animation-delay:80ms]">
        <div class="flex items-center gap-4">
          <Portrait size={56} eager alt={c.portraitAlt} class="md:hidden" />
          <SectionKicker>{c.kicker}</SectionKicker>
        </div>
        <h1 class="mt-6 text-h1">
          {c.h1Before}<span class="text-accent">Jérémy</span>{c.h1After}
        </h1>

        <div class="mt-7 max-w-2xl space-y-5 text-lead text-fg-muted">
          {c.bio.map((paragraph) => <p>{paragraph}</p>)}
        </div>

        <blockquote class="mt-8 max-w-2xl border-l-2 border-accent pl-5">
          <p class="text-h4 font-medium text-fg">{c.credo}</p>
        </blockquote>

        <div class="mt-9 flex flex-wrap items-center gap-x-4 gap-y-2">
          <StatusDot status="available" label={c.available} />
          <span class="text-fg-subtle" aria-hidden="true">·</span>
          <span class="font-mono text-mono-sm text-fg-muted">FR / EN</span>
          <span class="text-fg-subtle" aria-hidden="true">·</span>
          <span class="font-mono text-mono-sm text-fg-muted">{c.remote}</span>
        </div>

        <div class="mt-8 flex flex-wrap gap-3">
          <Button mail size="lg">
            <Icon name="mail" />
            {c.contact}
          </Button>
          <Button href={CONTACT.linkedin} size="lg" variant="secondary" external>
            LinkedIn
            <Icon name="arrow-up-right" />
          </Button>
        </div>
      </div>
    </div>
  </section>

  <!-- Hard skills -->
  <Section ariaLabelledby="skills-title">
    <SectionHeader
      id="skills-title"
      index={1}
      kicker={c.skillsKicker}
      title={c.skillsTitle}
      lead={c.skillsLead}
    />

    <dl
      class="mt-14 grid overflow-hidden rounded-xl border border-line bg-line [gap:1px] sm:grid-cols-2 lg:grid-cols-3"
    >
      {
        hardSkills.map((group) => (
          <div class="bg-surface p-6">
            <dt class="text-label text-fg-subtle">
              <span class="text-accent" aria-hidden="true">
                {'// '}
              </span>
              {group.category}
            </dt>
            <dd class="mt-4">
              <ul class="flex flex-wrap gap-1.5">
                {group.items.map((item) => (
                  <li>
                    <Tag size="md">{item}</Tag>
                  </li>
                ))}
              </ul>
            </dd>
          </div>
        ))
      }
      {
        // Closing cell so the 1px-gap grid never shows an empty slot
        // (11 groups → fills both the 2- and 3-column layouts).
        hardSkills.length % 2 === 1 && hardSkills.length % 3 === 2 && (
          <div class="bg-surface p-6 max-sm:hidden" aria-hidden="true">
            <p class="text-label text-fg-subtle">
              <span class="text-accent">{'// '}</span>
              {c.skillsFiller}
            </p>
          </div>
        )
      }
    </dl>
  </Section>

  <!-- Soft skills (with proof) -->
  <Section tone="subtle" ariaLabelledby="method-title">
    <SectionHeader
      id="method-title"
      index={2}
      kicker={c.methodKicker}
      title={c.methodTitle}
      lead={c.methodLead}
    />

    <div class="mt-14 grid gap-5 md:grid-cols-2">
      {
        softSkills.map((skill) => (
          <Card class="h-full">
            <h3 class="text-h3">{skill.title}</h3>
            <p class="mt-3 text-fg-muted">{skill.description}</p>
            <blockquote class="mt-auto pt-6">
              <div class="border-l-2 border-accent pl-4">
                <p class="text-fg italic" lang="fr">
                  &ldquo;{skill.proofQuote}&rdquo;
                </p>
                <footer class="text-label mt-3 text-fg-subtle">— {skill.proofAuthor}</footer>
              </div>
            </blockquote>
          </Card>
        ))
      }
    </div>
  </Section>

  <!-- Timeline -->
  <Section ariaLabelledby="timeline-title">
    <SectionHeader
      id="timeline-title"
      index={3}
      kicker={c.timelineKicker}
      title={c.timelineTitle}
    />
    <Timeline entries={timeline} class="mt-14" />
  </Section>

  <!-- Full testimonials -->
  <Section tone="subtle" id={c.recoId} ariaLabelledby="reco-title">
    <SectionHeader
      id="reco-title"
      index={4}
      kicker={c.recoKicker}
      title={c.recoTitle}
      lead={c.recoLead}
    >
      <Button slot="actions" href={CONTACT.linkedin} variant="secondary" external>
        {c.linkedinProfile}
        <Icon name="arrow-up-right" />
      </Button>
    </SectionHeader>

    <div class="mt-14 grid gap-5 lg:grid-cols-2">
      {testimonials.map((t) => <Testimonial testimonial={t} variant="full" lang={lang} />)}
    </div>
  </Section>

  <ContactCta title={c.ctaTitle} text={c.ctaText} />
</BaseLayout>
