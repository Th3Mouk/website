---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/ui/Button.astro';
import Card from '../components/ui/Card.astro';
import SectionKicker from '../components/ui/SectionKicker.astro';
import StatusDot from '../components/ui/StatusDot.astro';
import Tag from '../components/ui/Tag.astro';
import ArrowUpRight from '../components/icons/ArrowUpRight.astro';
import { testimonials } from '../data/testimonials';

interface Service {
  title: string;
  pitch: string;
  bullets: string[];
  href?: string;
}

const services: Service[] = [
  {
    title: 'Formation',
    pitch:
      'Modules sur mesure pour développeurs et équipes : PHP, Symfony, JavaScript, DevOps, IA. Approche cas pratiques + projets réels, alignée sur les attentes des entreprises.',
    bullets: ['Devs juniors → seniors', 'Cas pratiques & projets', 'Programmes sur mesure'],
    href: '/formation',
  },
  {
    title: 'Consulting',
    pitch:
      'Architecture, migrations, mise en place de CI/CD, stratégie de tests, audits techniques. Des solutions concrètes adaptées à votre contexte.',
    bullets: ['Architecture & migration', 'Audit & conformité', 'Performance & qualité'],
  },
  {
    title: 'Développement',
    pitch:
      'Applications modernes performantes, rénovation de bases de code legacy, nouvelles fonctionnalités. Code fiable, évolutif, en phase avec vos objectifs.',
    bullets: ['Apps web modernes', 'Modernisation legacy', 'Solutions sur mesure'],
  },
];

const stats = [
  { value: '50+', label: 'Personnes formées', meta: 'depuis 2013' },
  { value: '25+', label: 'Projets livrés', meta: 'apps & formations' },
  { value: '10+', label: 'Entreprises accompagnées', meta: 'partenariats & missions' },
];

// Date formatting in French for testimonial attribution
const formatDate = (iso: string) =>
  new Date(iso).toLocaleDateString('fr-FR', { year: 'numeric', month: 'long' });
---

<BaseLayout>
  <!-- Hero -->
  <section class="relative overflow-hidden border-b border-border">
    <div class="absolute inset-0 grid-dots opacity-60" aria-hidden="true"></div>
    <div
      class="absolute inset-x-0 top-0 -z-10 h-96 bg-gradient-to-b from-blue-500/10 via-transparent to-transparent dark:from-blue-500/5"
      aria-hidden="true"
    >
    </div>

    <div class="container-content relative grid gap-12 py-16 md:grid-cols-[1fr_auto] md:gap-16 md:py-24 lg:py-32">
      <div class="max-w-2xl">
        <SectionKicker class="mb-6">developer · educator · consultant</SectionKicker>

        <h1 class="text-balance text-display font-bold text-text">
          Jérémy <span class="text-blue-500">Marodon</span>
        </h1>

        <p class="mt-4 font-mono text-mono-sm uppercase tracking-wider text-text-muted">
          Formateur &amp; Consultant Technique Senior
        </p>

        <p class="mt-8 max-w-xl text-pretty text-lead text-text-muted">
          J'accompagne les entreprises et développeurs dans leur montée en compétences
          techniques, avec un focus sur des technologies modernes comme PHP, Symfony,
          React, DevOps et IA.
        </p>

        <div class="mt-10 flex flex-wrap items-center gap-3">
          <Button href="mailto:marodon.jeremy@gmail.com">
            Me contacter
            <ArrowUpRight class="h-4 w-4" />
          </Button>
          <Button href="/formation" variant="ghost">
            Voir les formations
          </Button>
        </div>

        <div class="mt-8 flex flex-wrap items-center gap-4">
          <StatusDot status="available" label="Ouvert aux missions" />
          <span class="font-mono text-mono-sm text-text-subtle">·</span>
          <span class="font-mono text-mono-sm text-text-muted">FR / EN</span>
          <span class="font-mono text-mono-sm text-text-subtle">·</span>
          <span class="font-mono text-mono-sm text-text-muted">Remote &amp; on-site</span>
        </div>
      </div>

      <!-- Avatar -->
      <div class="hidden md:flex md:items-center md:justify-end">
        <div class="relative">
          <div
            class="absolute inset-0 -z-10 rounded-full bg-blue-500/20 blur-2xl"
            aria-hidden="true"
          >
          </div>
          <picture>
            <source srcset="/profil2-blue.webp" type="image/webp" />
            <img
              src="/profil2-blue.jpg"
              alt="Portrait de Jérémy Marodon"
              width="320"
              height="320"
              loading="eager"
              decoding="async"
              class="h-72 w-72 rounded-full border border-border-strong object-cover shadow-xl"
            />
          </picture>
        </div>
      </div>
    </div>
  </section>

  <!-- Services -->
  <section class="border-b border-border py-20 md:py-28">
    <div class="container-content">
      <SectionKicker class="mb-3">services</SectionKicker>
      <h2 class="text-balance text-h2 font-bold">Trois manières de travailler ensemble</h2>
      <p class="mt-4 max-w-2xl text-pretty text-lead text-text-muted">
        Selon le besoin : transmettre, accompagner ou construire. Souvent les trois en
        même temps.
      </p>

      <div class="mt-12 grid gap-6 md:grid-cols-3">
        {
          services.map((service) => (
            <Card href={service.href} class="flex h-full flex-col">
              <h3 class="text-h3 font-bold text-text">{service.title}</h3>
              <p class="mt-3 text-text-muted">{service.pitch}</p>
              <ul class="mt-6 space-y-2 border-t border-border pt-4 font-mono text-mono-sm text-text-muted">
                {service.bullets.map((bullet) => (
                  <li class="flex items-start gap-2">
                    <span class="mt-1 text-blue-500" aria-hidden="true">
                      ›
                    </span>
                    <span>{bullet}</span>
                  </li>
                ))}
              </ul>
              {service.href && (
                <p class="mt-6 inline-flex items-center gap-1 font-mono text-mono-sm text-blue-500">
                  En savoir plus <ArrowUpRight class="h-3 w-3" />
                </p>
              )}
            </Card>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Stats -->
  <section class="border-b border-border bg-bg-subtle py-16">
    <div class="container-content">
      <SectionKicker class="mb-8">numbers</SectionKicker>
      <div class="grid gap-8 md:grid-cols-3">
        {
          stats.map((stat) => (
            <div>
              <p class="text-display font-bold text-blue-500">{stat.value}</p>
              <p class="mt-2 text-h3 font-bold text-text">{stat.label}</p>
              <p class="mt-1 font-mono text-mono-sm text-text-subtle">{stat.meta}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Testimonials -->
  <section class="border-b border-border py-20 md:py-28">
    <div class="container-content">
      <SectionKicker class="mb-3">testimonials</SectionKicker>
      <h2 class="text-balance text-h2 font-bold">Ce que disent ceux qui ont travaillé avec moi</h2>
      <p class="mt-4 max-w-2xl text-pretty text-lead text-text-muted">
        Recommandations LinkedIn issues d'anciens collègues et managers.
      </p>

      <div class="mt-12 grid gap-6 md:grid-cols-2">
        {
          testimonials.map((t) => (
            <Card class="flex h-full flex-col">
              <blockquote class="flex-1 text-text">
                <p class="text-pretty">&ldquo;{t.pullQuote}&rdquo;</p>
              </blockquote>
              <footer class="mt-6 flex items-center gap-4 border-t border-border pt-4">
                <img
                  src={t.photo}
                  alt=""
                  width="48"
                  height="48"
                  loading="lazy"
                  decoding="async"
                  class="h-12 w-12 rounded-full border border-border object-cover bg-bg-subtle"
                />
                <div class="min-w-0 flex-1">
                  <p class="truncate font-bold text-text">{t.name}</p>
                  <p class="truncate text-sm text-text-muted">{t.role}</p>
                </div>
                <Tag>{formatDate(t.date)}</Tag>
              </footer>
            </Card>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Formations CTA -->
  <section class="border-b border-border py-20">
    <div class="container-content">
      <Card href="/formation" class="bg-bg-subtle">
        <div class="flex flex-col gap-6 md:flex-row md:items-center md:justify-between">
          <div class="max-w-2xl">
            <SectionKicker class="mb-3">training</SectionKicker>
            <h2 class="text-h2 font-bold">Formations on-site</h2>
            <p class="mt-3 text-text-muted">
              11 modules taillés pour les équipes tech : PHP moderne, Symfony, JS/TS,
              bases de données, CI/CD, DevOps, IA et plus. Hands-on, programme adapté
              à votre stack.
            </p>
          </div>
          <p
            class="inline-flex shrink-0 items-center gap-2 font-mono text-mono-sm uppercase tracking-wider text-blue-500"
          >
            Voir le catalogue <ArrowUpRight class="h-4 w-4" />
          </p>
        </div>
      </Card>
    </div>
  </section>

  <!-- Contact -->
  <section class="py-20 md:py-28">
    <div class="container-content text-center">
      <SectionKicker class="mb-3 justify-center">contact</SectionKicker>
      <h2 class="text-balance text-h1 font-bold">On en discute ?</h2>
      <p class="mx-auto mt-4 max-w-xl text-pretty text-lead text-text-muted">
        Formation, audit, accompagnement, mission tech &mdash; envoie un mail, je
        réponds rapidement.
      </p>
      <div class="mt-10 flex flex-wrap items-center justify-center gap-3">
        <Button href="mailto:marodon.jeremy@gmail.com">
          marodon.jeremy@gmail.com
          <ArrowUpRight class="h-4 w-4" />
        </Button>
        <Button
          href="https://www.linkedin.com/in/jeremymarodon/"
          variant="ghost"
          external
        >
          LinkedIn
          <ArrowUpRight class="h-4 w-4" />
        </Button>
      </div>
    </div>
  </section>
</BaseLayout>
